{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BenchPod Desktop",
  "version": "0.0.0",
  "identifier": "com.embeddedci.benchpod-desktop",
  "build": {
    "frontendDist": "../loading"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "An AI agent that tests and debugs your board with a BenchPod",
    "longDescription": "Chat with an AI agent that drives your EmbeddedCI BenchPod: power your board, read its console, capture signals, emulate sensors and flash firmware. Works with any OpenAI-compatible model, including local ones.",
    "copyright": "Copyright EmbeddedCI contributors",
    "license": "Apache-2.0",
    "externalBin": [
      "binaries/benchpod-local"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    }
  }
}
