# Copy to .env (git-ignored) for development. An installed app reads <data folder>/.env too.
# The app stores keys typed into its settings in the system keychain instead.

# The model key, for whichever provider is selected (or OPENROUTER_API_KEY, ANTHROPIC_API_KEY,
# OPENAI_API_KEY for that preset only).
BENCHPOD_MODEL_API_KEY=

# Run the MCP server from a checkout instead of uvx, e.g. ../embeddedci-python/venv/bin/embeddedci-mcp
BENCHPOD_MCP_COMMAND=

# A cloud pod (connection embeddedci:<name>) without `benchpod login`.
BENCHPOD_API_KEY=
